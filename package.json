{
  "name": "atlantis-arena",
  "private": true,
  "version": "2.0.0",
  "engines": { "node": ">=20 <25" },
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/generate-assets.mjs",
    "assets:v2": "node scripts/process-v2-art.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.13"
  }
}
